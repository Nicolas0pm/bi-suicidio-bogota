# Copie este archivo como .env (NUNCA suba .env ni la llave JSON a GitHub)

# demo     -> datos locales en el servidor y usuarios de prueba (administrador|analista|consulta@demo.local)
# firebase -> Firestore + Firebase Authentication
MODO=demo

# Modo firebase
FIREBASE_CREDENCIALES=ruta/a/llave-cuenta-servicio.json
FIREBASE_WEB_API_KEY=

# Modo demo
DEMO_SECRETO=cambie-este-secreto
DEMO_CLAVE=demo1234

CACHE_SEGUNDOS=600
LIMITE_LOGIN_POR_MINUTO=10
